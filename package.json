{
  "name": "afterclass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "db:validate": "prisma validate --schema server/prisma/schema.prisma",
    "db:seed": "node server/prisma/seed.js",
    "test": "node --test tests/*.test.mjs",
    "review": "node scripts/review.cjs",
    "review:hearing-reset": "node scripts/review-hearing.cjs --reset",
    "ops:probe": "node scripts/health-probe.cjs",
    "ops:backup": "node scripts/recovery.cjs backup",
    "ops:restore-drill": "node scripts/recovery.cjs drill"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "resend": "^6.25.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "vite": "^7.3.8"
  },
  "overrides": {
    "qs": "^6.17.1",
    "deepmerge-ts": "^8.0.2",
    "@prisma/config": {
      "effect": "3.22.5"
    }
  }
}
